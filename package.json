{
  "name": "tuloy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:demo": "TULOY_DEMO=1 TULOY_PEER_ALLOW_LOCAL=1 node --env-file-if-exists=.env src/main.ts",
    "start:sample": "TULOY_DEMO=1 TULOY_PEER_ALLOW_LOCAL=1 TULOY_OWNER='Sam (sample owner)' TULOY_PORT=4001 TULOY_DATA_DIR=./data/sample node --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.166",
    "undici": "8.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.37",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
