# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Model IDs on OpenRouter. The backup is from a different vendor than the primary.
TULOY_PRIMARY_MODEL=
TULOY_BACKUP_MODEL=
# Optional. Defaults: owner "Owner", port 4000, data folder ./data
TULOY_OWNER=
TULOY_PORT=
# The address that Tuloy listens on. Default 127.0.0.1: this machine only. Set it (for example 0.0.0.0) to serve other machines.
TULOY_HOST=
TULOY_DATA_DIR=
# Optional limits. Defaults: 2 retries, waits of 2 s then 4 s; task time limit 60 s; heartbeat every 5 s, missed after 20 s;
# at most 2 model calls at the same time; at most 4000 output tokens for each model call.
TULOY_RETRIES=
TULOY_RETRY_WAIT_MS=
TULOY_TASK_TIME_LIMIT_MS=
TULOY_HEARTBEAT_MS=
TULOY_HEARTBEAT_MISSED_MS=
TULOY_MAX_MODEL_CALLS=
TULOY_MAX_OUTPUT_TOKENS=
# Demo mode: set to 1 to permit injections (failures made on purpose).
TULOY_DEMO=
# Optional. The limit of tasks per hour for each peer. Default 20
TULOY_PEER_TASKS_PER_HOUR=
# Two Tuloys on one laptop (the demo): set to 1 to permit plain-http addresses of peers on this same machine.
# Off by default: a peer's address must be https and public.
TULOY_PEER_ALLOW_LOCAL=
# 1 = the trend scout searches the web with OpenRouter's web search (same key). A search costs money. Off by default.
TULOY_TREND_SEARCH=

# For a Tuloy on a server (see "Host a Tuloy" in the README). Keep the real values in the provider's secret store.
# The name in the address bar, for example lou.example.com (no https://, no port).
TULOY_PUBLIC_HOST=
# The password of the page and its API, 16 characters or more. A Tuloy that is open to a network does not start with none.
TULOY_DASHBOARD_PASSWORD=
